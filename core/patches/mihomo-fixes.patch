@@ -0,0 +1,39 @@
+package adapter
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"strconv"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/adapter/outbound"
+	"github.com/metacubex/mihomo/common/utils"
+)
+
+func TestURLTestRejectsUnexpectedStatus(t *testing.T) {
+	expected, err := utils.NewUnsignedRanges[uint16]("200-204")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, status := range []int{204, 302, 403, 503} {
+		t.Run(strconv.Itoa(status), func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+				w.WriteHeader(status)
+			}))
+			defer server.Close()
+			proxy := NewProxy(outbound.NewDirectWithOption(outbound.DirectOption{Name: "DIRECT"}))
+			ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+			defer cancel()
+			delay, testErr := proxy.URLTest(ctx, server.URL, expected)
+			if status == 204 {
+				if testErr != nil || delay == 0 || !proxy.AliveForTestUrl(server.URL) {
+					t.Fatalf("accepted response: delay=%d error=%v", delay, testErr)
+				}
+			} else if testErr == nil || delay != 0 || proxy.AliveForTestUrl(server.URL) {
+				t.Fatalf("status %d accepted: delay=%d error=%v", status, delay, testErr)
+			}
+		})
+	}
+}
