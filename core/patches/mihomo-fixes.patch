+type probeTask struct {
+	cancel   context.CancelFunc
+	waiters  int
+	done     chan struct{}
+	val      uint16
+	err      error
+	retiring bool
+}
+
+type cancellableProbePool struct {
+	mu    sync.Mutex
+	tasks map[string]*probeTask
