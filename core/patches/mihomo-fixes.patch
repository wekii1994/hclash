+var globalProbePool = &cancellableProbePool{
+	tasks: make(map[string]*probeTask),
+}
+
+type probeRoundCtxKey struct{}
+
+func WithProbeRound(ctx context.Context, round any) context.Context {
+	return context.WithValue(ctx, probeRoundCtxKey{}, round)
+}
+
+func ProbeRoundFromContext(ctx context.Context) any {
+	return ctx.Value(probeRoundCtxKey{})
+}
+
+func (p *cancellableProbePool) Do(
+	ctx context.Context,
+	key string,
+	timeout time.Duration,
+	run func(workCtx context.Context) (uint16, error),
+) (uint16, error) {
+	if err := ctx.Err(); err != nil {
+		return 0, err
+	}
+
+	p.mu.Lock()
+	var task *probeTask
+	for {
+		t, exists := p.tasks[key]
+		if !exists {
+			workCtx, cancel := context.WithCancel(context.Background())
+			task = &probeTask{
+				cancel:  cancel,
+				waiters: 1,
+				done:    make(chan struct{}),
+			}
+			p.tasks[key] = task
+			p.mu.Unlock()
+
+			go func() {
+				defer func() {
+					task.cancel()
+					p.mu.Lock()
+					if p.tasks[key] == task {
+						delete(p.tasks, key)
+					}
+					task.retiring = true
+					close(task.done)
+					p.mu.Unlock()
+				}()
+
+				val, err := run(workCtx)
+				task.val = val
+				task.err = err
+			}()
+			break
+		}
+
+		if t.retiring {
+			if p.tasks[key] == t {
+				delete(p.tasks, key)
+			}
+			continue
+		}
+
+		t.waiters++
+		task = t
+		p.mu.Unlock()
+		break
+	}
+
+	select {
+	case <-ctx.Done():
+		var toCancel context.CancelFunc
+		p.mu.Lock()
+		task.waiters--
+		if task.waiters == 0 && !task.retiring {
+			task.retiring = true
+			if p.tasks[key] == task {
+				delete(p.tasks, key)
+			}
+			toCancel = task.cancel
+		}
+		p.mu.Unlock()
+
+		if toCancel != nil {
+			toCancel()
+		}
+		return 0, ctx.Err()
+
+	case <-task.done:
+		p.mu.Lock()
+		task.waiters--
+		p.mu.Unlock()
+
+		if err := ctx.Err(); err != nil {
+			return 0, err
+		}
+		return task.val, task.err
+	}
+}
